@model List<Assignment_1.Models.Contact>
@{
    ViewBag.Title = "Index";
}

<h2>Contact List</h2>

<p>@Html.ActionLink("Create New Contact","Create")</p>

<table class="table table-bordered table-striped" >
    <thead>
        <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Email</td>
                <td>
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                </td>
            </tr>
        }
    </tbody>

</table>
