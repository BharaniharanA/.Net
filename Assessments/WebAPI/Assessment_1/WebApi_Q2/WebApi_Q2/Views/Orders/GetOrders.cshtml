@model IEnumerable<WebApi_Q2.Models.Order>

@{
    ViewBag.Title = "GetOrders";
}


<h2 class="mb-4">Orders List</h2>

<table class="table table-striped table-hover table-bordered shadow">
    <thead class="table-dark">
        <tr>
            <th>Order ID</th>
            <th>Order Date</th>
            <th>Ship Name</th>
            <th>Country</th>
            <th>Freight</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderID</td>
                <td>@item.OrderDate</td>
                <td>@item.ShipName</td>
                <td>@item.ShipCountry</td>
                <td>@item.Freight</td>
                
            </tr>
        }
    </tbody>
</table>