@model IEnumerable<Northwind_MVC.Models.Customer>
@{
    ViewBag.Title = "GetCustomersByCountry";
}


<h2>Customers Details</h2>

<div class="container md-4">
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover shadow">
            <thead class="table-dark text-center">
                <tr>
                    <th>Customer ID</th>
                    <th>Company Name</th>
                    <th>Contact Name</th>
                    <th>Contact Title</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>Region</th>
                    <th>Postal Code</th>
                    <th>Country</th>
                    <th>Phone</th>
                    <th>Fax</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CustomerID</td>
                        <td>@item.CompanyName</td>
                        <td>@item.ContactName</td>
                        <td>@item.ContactTitle</td>
                        <td>@item.Address</td>
                        <td>@item.City</td>
                        <td>@item.Region</td>
                        <td>@item.PostalCode</td>
                        <td>@item.Country</td>
                        <td>@item.Phone</td>
                        <td>@item.Fax</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


