@model IEnumerable<Movie_MVC.Models.Movie>

@{
    ViewBag.Title = "Index";
}
<div class="container mt-4">

    <h2 class="text-center mb-4">Movies List</h2>

    <div class="mb-3">
        @Html.ActionLink("Add New Movie", "Create" )<br/>
        @Html.ActionLink("Search by Year", "ByYear")<br />
        @Html.ActionLink("Search by Director", "ByDirector")
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Movie Name</th>
                <th>Director</th>
                <th>Release Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MovieName</td>
                    <td>@item.DirectorName</td>
                    <td>@item.DateOfRelease.ToString("yyyy-MM-dd")</td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.Mid } )
                        @Html.ActionLink("Delete", "Delete", new { id = item.Mid })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>